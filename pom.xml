<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.activeviam.apps</groupId>
  <artifactId>atoti-spring-boot-template</artifactId>
  <version>6.1.20</version>
  <description>Template project for Spring Boot</description>

  <properties>
    <java.version>25</java.version>
    <spring-boot.version>${project.parent.version}</spring-boot.version>
    <atoti-server.version>6.2.0</atoti-server.version>
    <springdoc.version>3.1.0</springdoc.version>

    <opentelemetry.version>1.63.0</opentelemetry.version>
    <opentelemetry-instrumentation.version>2.29.0</opentelemetry-instrumentation.version>
    <opentelemetry-logback-mdc.version>2.29.0-alpha</opentelemetry-logback-mdc.version>

    <spotless-maven-plugin.version>3.8.0</spotless-maven-plugin.version>
    <palantir-java-format.version>2.96.0</palantir-java-format.version>

    <flight-sql-jdbc-driver.version>19.0.0</flight-sql-jdbc-driver.version>
    <jolokia.version>2.6.1</jolokia.version>

    <!-- ActiveViam-recommended security pins ahead of Spring Boot 4.1.0's own managed versions,
         per the Atoti 6.2 migration notes (PIVOT-14395: CVE-2026-55276, CVE-2026-53434,
         CVE-2026-53404, CVE-2026-44891, CVE-2026-54399, CVE-2026-54428). -->
    <tomcat.version>11.0.24</tomcat.version>
    <netty.version>4.2.16.Final</netty.version>
    <httpcore5.version>5.4.3</httpcore5.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-instrumentation-bom</artifactId>
        <version>${opentelemetry-instrumentation.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Spring Boot -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Exposes MBean reads over HTTP at /actuator/jolokia, auto-registered since actuator exposure
         is already "*" in application.yml. Needed to read the AggregatesCacheMonitoring MBean
         (NbOfEntries/Capacity) - the aggregates cache has no Prometheus/OTEL metric, only JMX. -->
    <dependency>
      <groupId>org.jolokia</groupId>
      <artifactId>jolokia-support-springboot</artifactId>
      <version>${jolokia.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- DirectQuery: Dremio via the generic JDBC connector -->
    <dependency>
      <groupId>com.activeviam.activepivot</groupId>
      <artifactId>activepivot-external-database</artifactId>
      <version>${atoti-server.version}</version>
    </dependency>
    <dependency>
      <groupId>com.activeviam.directquery</groupId>
      <artifactId>api-application</artifactId>
      <version>${atoti-server.version}</version>
    </dependency>
    <dependency>
      <groupId>com.activeviam.directquery</groupId>
      <artifactId>api-generic-jdbc</artifactId>
      <version>${atoti-server.version}</version>
    </dependency>
    <dependency>
      <groupId>com.activeviam.database.jdbc.dialect.dremio</groupId>
      <artifactId>dremio-dialect</artifactId>
      <version>${atoti-server.version}</version>
      <!-- dremio-dialect itself pulls in the shaded flight-sql-jdbc-driver transitively; excluded here
           since we depend on the unshaded flight-sql-jdbc-core below instead (see that dependency's
           comment for why). -->
      <exclusions>
        <exclusion>
          <groupId>org.apache.arrow</groupId>
          <artifactId>flight-sql-jdbc-driver</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Unshaded flight-sql-jdbc-core (not the shaded flight-sql-jdbc-driver uber-jar): its bundled,
         relocated Netty copy's PooledByteBufAllocatorL unconditionally probes an empty buffer's native
         memory address at class-init time, which throws UnsupportedOperationException on Java 25 (Netty
         4.x's sun.misc.Unsafe-based direct-memory path breaks under JEP 471 - see
         https://github.com/apache/arrow-java/issues/728). Excluding arrow-memory-netty and adding
         arrow-memory-unsafe swaps in Arrow's Unsafe-based allocator, which has no such Netty allocator and
         initializes cleanly. Same driver class/JDBC service registration as the shaded jar
         (org.apache.arrow.driver.jdbc.ArrowFlightJdbcDriver), so no code/URL changes needed elsewhere. -->
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>flight-sql-jdbc-core</artifactId>
      <version>${flight-sql-jdbc-driver.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.arrow</groupId>
          <artifactId>arrow-memory-netty</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-unsafe</artifactId>
      <version>${flight-sql-jdbc-driver.version}</version>
    </dependency>

    <!-- OpenTelemetry -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-logback-mdc-1.0</artifactId>
      <version>${opentelemetry-logback-mdc.version}</version>
    </dependency>

    <!-- ActiveViam Starters -->
    <dependency>
      <groupId>com.activeviam.springboot</groupId>
      <artifactId>excel-addin-starter</artifactId>
      <version>${atoti-server.version}</version>
    </dependency>
    <dependency>
      <groupId>com.activeviam.springboot</groupId>
      <artifactId>atoti-server-starter</artifactId>
      <version>${atoti-server.version}</version>
      <!-- Atoti 6.1.x brings an incompatible version of swagger-* deps that makes Swagger UI fails -->
      <exclusions>
        <exclusion>
          <groupId>io.swagger.core.v3</groupId>
          <artifactId>swagger-annotations-jakarta</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.activeviam.springboot</groupId>
      <artifactId>atoti-ui-starter</artifactId>
      <version>${atoti-server.version}</version>
    </dependency>
    <dependency>
      <groupId>com.activeviam.springboot</groupId>
      <artifactId>atoti-admin-ui-starter</artifactId>
      <version>${atoti-server.version}</version>
    </dependency>

    <!-- Content Server persistence -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-hikaricp</artifactId>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>

    <!-- JGroups JDBC_PING discovery (data-node/query-node cluster) -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
    </dependency>

    <!-- Swagger -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TestRestTemplate moved out of spring-boot-test in Spring Boot 4 and is no longer
         auto-configured; this module plus @AutoConfigureTestRestTemplate on the test class
         bring it back (see AtotiSpringBootApplicationTest). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.activeviam</groupId>
      <artifactId>atoti-server-test</artifactId>
      <version>${atoti-server.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <!-- Atoti 6.2.0 artifacts are only published to the client-facing "mvn-prod" channel, not the
       "mvn-internal" one already configured server-wide (which still tops out at the 6.1.x line).
       Credentials for this repository id must be added under <servers> in ~/.m2/settings.xml. -->
  <repositories>
    <repository>
      <id>ActiveViamProdRepository</id>
      <name>ActiveViam Production Repository</name>
      <url>https://activeviam.jfrog.io/artifactory/mvn-prod/</url>
    </repository>
  </repositories>

  <build>
    <finalName>atoti-spring-boot-template</finalName>

    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
        <includes>
          <include>**/application*.yml</include>
          <include>**/application*.yaml</include>
        </includes>
      </resource>
      <resource>
        <filtering>false</filtering>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>**/application*.yml</exclude>
          <exclude>**/application*.yaml</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <!-- limit format enforcement to just the files changed by this feature branch -->
          <ratchetFrom>origin/6.1</ratchetFrom>
          <!-- define a language-specific format -->
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>

            <importOrder>
              <!-- or a custom ordering -->
              <order>\\#,java,javax,org,com,com.diffplug,</order>
              <!-- or use <file>${project.basedir}/eclipse.importorder</file> -->
              <!-- you can use an empty string for all the imports you didn't specify explicitly, and '\\#` prefix for static imports. -->
            </importOrder>

            <removeUnusedImports/>
            <licenseHeader>
              <file>./.idea/copyright/spotless.license</file>
            </licenseHeader>
          </java>
          <pom>
            <!-- These are the defaults, you can override if you want -->
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <sortPom>
              <!-- has its own section below -->
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <!-- You have to set the target manually -->
              <include>**/*.md</include>
            </includes>
            <flexmark/>
            <!-- has its own section below -->
          </markdown>
          <yaml>
            <includes>
              <!-- You have to set the target manually -->
              <include>**/*.yaml</include>
              <include>**/*.yml</include>
            </includes>
          </yaml>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>--add-opens java.base/java.util.concurrent=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
